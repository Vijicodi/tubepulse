# Copy this file to .env.local and fill it in. .env.local is gitignored.
#
# Anything prefixed NEXT_PUBLIC_ is shipped to the browser. Everything else is
# server-only and read through serverEnv() in src/lib/env.ts.

# --- Supabase -----------------------------------------------------------------
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://yourproject.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Same URL again, for the server. Kept separate so the server never depends on
# a NEXT_PUBLIC_ value that a future refactor might change.
SUPABASE_URL=https://yourproject.supabase.co

# Bypasses row-level security. Only the Apify webhook uses it. Never expose it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Apify --------------------------------------------------------------------
# console.apify.com → Settings → Integrations → API token
APIFY_TOKEN=

# The actor that scrapes YouTube channels.
APIFY_YOUTUBE_ACTOR=streamers/youtube-scraper

# Shared secret proving a webhook really came from your Apify run.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APIFY_WEBHOOK_SECRET=

# --- Firecrawl ----------------------------------------------------------------
FIRECRAWL_API_KEY=

# --- Anthropic ----------------------------------------------------------------
# console.anthropic.com — separate from a Claude Code subscription.
ANTHROPIC_API_KEY=

# --- App ----------------------------------------------------------------------
# Where Apify sends webhooks back to. Must be publicly reachable — for local
# development use a tunnel (ngrok, cloudflared), not localhost.
APP_URL=http://localhost:3000
